{
  "name": "online-tools-website",
  "version": "1.0.0",
  "description": "Production-ready multi-tool online utility website built with Node.js, Express and vanilla JS. File-based storage, fully working admin panel, 10 working tools.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "seed": "node scripts/seed-images.js",
