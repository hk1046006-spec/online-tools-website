<?xml version="1.0" encoding="UTF-8"?>
<!--
  ToolBox — static fallback copy.
  Express generates /sitemap.xml dynamically from the tool catalogue and the
  canonical base URL configured in the admin panel. This file only applies if you
  host public/ on a static server. Replace example.com with your domain first.
-->
