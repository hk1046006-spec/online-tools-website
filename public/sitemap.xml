  <url><loc>https://example.com/tools/image-compressor</loc><changefreq>monthly</changefreq><priority>0.9</priority></url>
  <url><loc>https://example.com/tools/qr-code-generator</loc><changefreq>monthly</changefreq><priority>0.9</priority></url>
  <url><loc>https://example.com/tools/password-generator</loc><changefreq>monthly</changefreq><priority>0.9</priority></url>
  <url><loc>https://example.com/tools/word-counter</loc><changefreq>monthly</changefreq><priority>0.9</priority></url>
  <url><loc>https://example.com/tools/json-formatter</loc><changefreq>monthly</changefreq><priority>0.9</priority></url>
  <url><loc>https://example.com/tools/color-picker</loc><changefreq>monthly</changefreq><priority>0.9</priority></url>
  <url><loc>https://example.com/tools/unit-converter</loc><changefreq>monthly</changefreq><priority>0.9</priority></url>
  <url><loc>https://example.com/tools/age-calculator</loc><changefreq>monthly</changefreq><priority>0.9</priority></url>
